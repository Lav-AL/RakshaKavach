# ─── Build outputs ────────────────────────────────────────────────────────────
/build
app/build
**/build/

# ─── Gradle cache (local machine only) ────────────────────────────────────────
.gradle/
gradle-wrapper.jar

# ─── Android Studio IDE files ─────────────────────────────────────────────────
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.idea/modules.xml
captures/

# ─── Local machine configuration ──────────────────────────────────────────────
# Contains SDK path — differs per machine, never commit
local.properties

# ─── Compiled / binary files ──────────────────────────────────────────────────
*.apk
*.aab
*.ap_
*.class
*.dex

# ─── Keystore (CRITICAL: never commit signing keys) ───────────────────────────
*.jks
*.keystore

# ─── Logs & temp files ────────────────────────────────────────────────────────
*.log
*.tmp
*.swp
.DS_Store
Thumbs.db

# ─── Firebase / Google Services ───────────────────────────────────────────────
# Uncomment when added:
# google-services.json
