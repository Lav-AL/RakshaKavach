<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/black"
    android:padding="32dp">

    <TextView
        android:id="@+id/iv_shield"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:gravity="center"
        android:text="🛡️"
        android:textSize="80sp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tv_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RAKSHA-KAVACH"
        android:textColor="@color/warning_yellow"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Worker Safety Auditor"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:layout_marginBottom="48dp" />

    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/warning_yellow" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Securing your workplace..."
        android:textColor="#88FFFFFF"
        android:textSize="12sp"
        android:layout_marginTop="16dp" />

</LinearLayout>
